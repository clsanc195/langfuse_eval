# ============================================================================
# observability_comparison — environment template
# Copy to .env and fill in the values. .env is git-ignored.
# ============================================================================

# ---- Anthropic (used by all three notebooks) -------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---- Langfuse (self-hosted, brought up by ./setup.sh) ----------------------
# After running ./setup.sh, open http://localhost:3000, sign up, create an
# organization + project, then Settings -> API Keys -> create a key pair.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# ---- LangSmith (SaaS, free Developer tier) ---------------------------------
# Sign up: https://smith.langchain.com
# Settings -> API Keys -> Create API Key
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=observability-comparison

# ---- Galileo (SaaS, free tier) ---------------------------------------------
# Sign up: https://app.galileo.ai/sign-up
#   - Free tier, no credit card, starter trace/eval quota per month
#   - Verify email, pick a workspace name when prompted
# Get API key:
#   - Top-right user menu -> API Keys -> Create API Key
# Project / log stream:
#   - The SDK will create them on first use if they don't exist.
#   - "observability-comparison" / "default" are fine.
GALILEO_API_KEY=
GALILEO_PROJECT=observability-comparison
GALILEO_LOG_STREAM=default
GALILEO_CONSOLE_URL=https://app.galileo.ai
